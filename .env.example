# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram user IDs that can approve registrations
ADMIN_TELEGRAM_IDS=123456789

# DAPNET operator account (sends pages to each user's callsign)
# Germany: https://hampager.de/api
# Spain:   http://dapnet.es:8080
DAPNET_API_URL=https://hampager.de/api
DAPNET_API_URL_ES=http://dapnet.es:8080
DAPNET_CALLSIGN=yourcall
DAPNET_PASSWORD=your-dapnet-password
DAPNET_DEFAULT_TX_GROUP=all
DAPNET_DEFAULT_SERVER=de

# Fernet key used to encrypt Nextcloud app passwords at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Scheduler
SYNC_INTERVAL_SECONDS=600
DISPATCH_INTERVAL_SECONDS=60
FETCH_EVENT_WINDOW_DAYS=14
MISFIRE_GRACE_MINUTES=30

# Defaults for new users
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_LEAD_MINUTES=60
DEFAULT_REPEAT_COUNT=1

LOG_LEVEL=INFO
